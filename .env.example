# Copia este archivo como .env (en la raíz del proyecto) y completa SOLO con
# el proveedor de IA que la organización haya autorizado para la competencia.
# Nunca subas .env al repositorio.

# --- IA (triaje de incidencias) ---------------------------------------------
# anthropic          -> API de Claude (Anthropic) con el SDK oficial
# openai_compatible  -> cualquier endpoint /chat/completions autorizado:
#                       Google Gemini, OpenAI, Groq o un modelo local (Ollama)
# Vacío              -> IA desactivada: la app funciona con clasificación manual
IA_PROVEEDOR=
# Identificador exacto del modelo autorizado
# (p. ej. claude-opus-5-5 para anthropic, gemini-3.8-flash para Gemini)
IA_MODELO=
# Clave de la API (obligatoria para anthropic; opcional en modelos locales)
IA_API_KEY=
# Solo para openai_compatible:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama: http://127.0.0.1:11434/v1
# Para anthropic se puede dejar vacío (usa https://api.anthropic.com).
IA_URL_BASE=
# Solo para openai_compatible. Esfuerzo de razonamiento (low | medium | high);
# vacío si el modelo no razona. Para Gemini 3, low = respuestas más rápidas.
IA_ESFUERZO=
# Solo para openai_compatible. Cómo se pide el JSON: json_schema (por defecto),
# json_object o ninguno. La respuesta se valida siempre en el servidor.
IA_FORMATO_JSON=json_schema
# Solo para openai_compatible. Vacío = valor por defecto del modelo
# (recomendado para Gemini 3).
IA_TEMPERATURA=
# Tiempo máximo de espera por respuesta, en milisegundos
IA_TIMEOUT_MS=25000
# Consultas máximas por minuto (protege la cuota del proveedor)
IA_LIMITE_POR_MINUTO=15

# --- Servidor y datos --------------------------------------------------------
API_PORT=3000
HOST=127.0.0.1
# Base de datos SQLite operativa (se crea sola)
DB_PATH=
# Carpeta con los archivos oficiales de Campuslands (solo lectura)
DATOS_OFICIALES_DIR=
